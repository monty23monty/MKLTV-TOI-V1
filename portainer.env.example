# Add these values in Portainer's stack Environment variables section.
# With the Linux CLI, copy to .env.portainer and use --env-file .env.portainer.
# Replace both empty secrets with different long random values before deployment.
POSTGRES_PASSWORD=
TOI_AUTH_TOKEN=

TOI_IMAGE_TAG=portainer-v1
TOI_FRONTEND_PORT=8080
TOI_BIND_ADDRESS=0.0.0.0
POSTGRES_DB=lightning_toi
POSTGRES_USER=toi

# No trailing slash. Use the URL the iPad opens, including its port if nonstandard.
TOI_CORS_ORIGINS=http://192.168.1.50:8080
TOI_CLOCK_SOURCE=manual
