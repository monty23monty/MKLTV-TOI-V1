# Copy to .env.release for Docker Compose CLI, or enter these values in Portainer.
# Reuse the existing database credentials and stack name when upgrading v1.
TOI_RELEASE_TAG=v2.0.1
TOI_IMAGE_REGISTRY=ghcr.io/monty23monty
TOI_PULL_POLICY=missing
POSTGRES_DB=lightning_toi
POSTGRES_USER=toi
POSTGRES_PASSWORD=
TOI_AUTH_TOKEN=
TOI_OPERATOR_TOKENS=
TOI_SERVICE_TOKENS=
TOI_STREAM_ENABLED=true
TOI_STREAM_TICK_HZ=5
TOI_STREAM_JOURNAL_RETENTION_DAYS=7
TOI_STREAM_CLOCK_STALE_MS=3000
TOI_STREAM_MAX_CONNECTIONS=32
TOI_STREAM_QUEUE_MAX_BYTES=8388608
TOI_FRONTEND_PORT=8080
TOI_BIND_ADDRESS=0.0.0.0
# Replace this with the exact address the iPad uses, without a trailing slash.
TOI_CORS_ORIGINS=http://192.168.1.50:8080
TOI_CLOCK_SOURCE=manual
TOI_CLOCK_STALE_MS=10000
