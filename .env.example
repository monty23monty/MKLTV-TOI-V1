# Used by Docker Compose. Change the local database password before shared use.
POSTGRES_DB=lightning_toi
POSTGRES_USER=toi
POSTGRES_PASSWORD=toi_local_only
TOI_FRONTEND_PORT=8080
TOI_BACKEND_PORT=8000

# Native backend defaults to SQLite; Compose overrides with PostgreSQL.
TOI_DATABASE_URL=sqlite:///./data/toi.db
TOI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Empty auth settings explicitly enable the standalone local demonstration.
# For a protected prototype, set an opaque bearer token and enter it in the UI.
TOI_AUTH_TOKEN=
# Or configure individual operator principals; null team_ids grants all teams.
# TOI_OPERATOR_TOKENS={"replace-with-token":{"actor":"operator-1","team_ids":null,"can_control_clock":true}}
TOI_OPERATOR_TOKENS=

# Only observations from this source are accepted. 'manual' is standalone mode.
TOI_CLOCK_SOURCE=manual
TOI_CLOCK_STALE_MS=10000

# V2 duplex clock / live TOI / replayable feed; see SERVICE_INTERFACE.md.
# Enabled by supplied Compose files; unset standalone Python defaults to false.
TOI_STREAM_ENABLED=true
TOI_SERVICE_TOKENS=
TOI_STREAM_TICK_HZ=5
TOI_STREAM_JOURNAL_RETENTION_DAYS=7
TOI_STREAM_CLOCK_STALE_MS=3000
TOI_STREAM_MAX_CONNECTIONS=32
TOI_STREAM_QUEUE_MAX_BYTES=8388608

# Optional server-side match/roster import. Game IDs must be positive integers.
HOKEJOVY_ZAPIS_BASE_URL=https://api.hokejovyzapis.cz
HOKEJOVY_ZAPIS_API_PREFIX=/v1/d07ssvctxm
HOKEJOVY_ZAPIS_TIMEOUT_SECONDS=10
HOKEJOVY_ZAPIS_CACHE_TTL_SECONDS=60
# Comma-separated trusted HTTPS hosts; change alongside BASE_URL for a proxy.
HOKEJOVY_ZAPIS_ALLOWED_HOSTS=api.hokejovyzapis.cz

# Optional separate frontend deployment (Vite build-time variable).
# VITE_API_BASE_URL=https://toi-api.example.internal
